# No application passphrase is required. Keep 30002 inside your trusted LAN or VPN.
# This parallel advisor service has an independent data volume from port 30001.
# Optional: GUANPAN_ADVISOR_PORT=30002
# Optional: GUANPAN_NEXT_DATA=/data

# DeepSeek only runs after you set your own API key on NAS. Never commit .env.
# Preset profiles: flash -> deepseek-v4-flash, pro -> deepseek-v4-pro, custom.
# Old model names deepseek-chat / deepseek-reasoner were retired on 2026-07-24; do not use them.
# Fill DEEPSEEK_API_KEY below, then verify with:
#   curl http://127.0.0.1:30002/v1/ai/verify     (state=verified means it really works)
DEEPSEEK_API_KEY=
GUANPAN_AI_PROFILE=flash
# Only for GUANPAN_AI_PROFILE=custom; HTTPS OpenAI-compatible endpoint:
GUANPAN_AI_BASE_URL=
GUANPAN_AI_MODEL=
